generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ##################################################
// #                  USER & DEPT                   #
// ##################################################

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clerkId      String?     @unique
  firstName    String?
  lastName     String?
  username     String?     @unique
  imageUrl     String?
  email        String?
  role         String? // e.g., "admin", "user"
  position     String? // e.g., "higher", "lower"
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations to Incident
  reportedIncidents Incident[] @relation("ReportedIncidents")
  assignedIncidents Incident[] @relation("AssignedIncidents")

  notifications          Notification[]
  UserIncidentReadStatus UserIncidentReadStatus[]
}

model Department {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String?        @unique
  incidents     Incident[]
  groupMessages GroupMessage[]
  users         User[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ##################################################
// #              INCIDENT CORE MODELS              #
// ##################################################

model Incident {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentNumber Int    @unique @default(autoincrement()) // Human-readable, sequential ID

  // --- Core Details ---
  title       String
  description String?          @db.Text
  status      IncidentStatus   @default(REPORTED)
  severity    IncidentSeverity @default(MEDIUM)
  priority    IncidentPriority @default(NORMAL)

  // --- Timestamps ---
  occurredAt DateTime  // When the incident actually happened
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now()) // When the report was created
  updatedAt  DateTime  @updatedAt

  // --- Categorization & Location ---
  locationAddress   String? // For human-readable address or description
  locationLatitude  Float? // For map integration
  locationLongitude Float? // For map integration
  affectedServices  String[] // For non-physical services/apps affected

  // --- Relations ---
  category     IncidentCategory @relation(fields: [categoryId], references: [id])
  categoryId   String           @db.Uuid
  department   Department       @relation(fields: [departmentId], references: [id])
  departmentId String           @db.Uuid

  // --- People ---
  reporter   User    @relation("ReportedIncidents", fields: [reporterId], references: [id])
  reporterId String  @db.Uuid  
  assignee   User?   @relation("AssignedIncidents", fields: [assigneeId], references: [id])
  assigneeId String? @db.Uuid

  // --- Analysis & Communication ---
  communicationChannel String? @db.Text // Link to Slack channel, etc.
  rootCause            String? @db.Text

  // --- Related Data ---
  statusNotes            IncidentStatusNote[]
  attachments            Attachment[]
  UserIncidentReadStatus UserIncidentReadStatus[]
}

model IncidentCategory {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique // e.g., "Technical", "HR", "Facilities"
  description String?
  isActive    Boolean    @default(true)
  incidents   Incident[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model IncidentStatusNote {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String         @db.Uuid
  incident    Incident       @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  changedById String? // Clerk user ID
  status      IncidentStatus
  note        String         @db.Text
  changedAt   DateTime       @default(now())

  @@index([incidentId])
}

model UserIncidentReadStatus {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  incidentId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())

  @@unique([userId, incidentId])
}

model Attachment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url        String
  fileName   String?
  incidentId String   @db.Uuid
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ##################################################
// #                 CHAT & NOTIFICATIONS           #
// ##################################################

model DirectMessage {
  id          String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text        String?
  senderId    String
  receiverId  String
  roomName    String
  attachments DirectMessageAttachment[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model DirectMessageAttachment {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  fileName  String?
  type      AttachmentType
  messageId String         @db.Uuid
  message   DirectMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model GroupMessage {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text         String?
  senderId     String
  departmentId String                   @db.Uuid
  roomName     String
  attachments  GroupMessageAttachment[]
  department   Department               @relation(fields: [departmentId], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

model GroupMessageAttachment {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url       String
  fileName  String?
  type      AttachmentType
  messageId String         @db.Uuid
  message   GroupMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
}

model Notification {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type        NotificationType
  message     String
  url         String?
  recipientId String           @db.Uuid
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  readAt      DateTime?
}

// ##################################################
// #                      ENUMS                     #
// ##################################################

enum IncidentStatus {
  REPORTED
  ACKNOWLEDGED
  INVESTIGATING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum AttachmentType {
  IMAGE
  VIDEO
  FILE
}

enum NotificationType {
  DIRECT_MESSAGE
  GROUP_MESSAGE
  INCIDENT
}
